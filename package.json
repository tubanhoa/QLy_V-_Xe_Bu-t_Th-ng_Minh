{
  "name": "smart-bus-ticketing-system",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Bus Ticketing System - ICTU (Monorepo Architecture: Frontend & Backend)",
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:all": "node scripts/start-dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start": "node scripts/start-dev.mjs",
    "test:backend": "npm --prefix backend run test"
  }
}
