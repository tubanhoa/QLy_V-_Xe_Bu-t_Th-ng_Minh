# ============ DATABASE ============
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=smart_bus_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_bus_db

# ============ REDIS ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ============ JWT ============
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ============ APP ============
APP_PORT=3001
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# ============ SEAT LOCK ============
SEAT_LOCK_TTL_SECONDS=600

# ============ GPS ============
GPS_PING_INTERVAL_MS=3000
STATION_ALERT_RADIUS_METERS=500

# ============ VNPAY (Sandbox) ============
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/result

# ============ MOMO (Sandbox) ============
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# ============ EMAIL ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============ QR TICKET SIGNING ============
QR_HMAC_SECRET=your-qr-signing-secret-change-in-production
