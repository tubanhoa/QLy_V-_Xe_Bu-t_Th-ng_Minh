# Cấu hình kết nối cơ sở dữ liệu và ứng dụng
# Copy file này thành .env và điền thông tin thực

# === Database Configuration ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_bus_db
DB_USER=root
DB_PASSWORD=your_password_here

# === App Configuration ===
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production

# === API Configuration ===
API_V1_PREFIX=/api/v1
PROJECT_NAME=Smart Bus Ticketing System
PROJECT_VERSION=1.0.0
